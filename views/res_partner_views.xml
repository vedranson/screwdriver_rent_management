<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_form_view_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.screwdriver.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='sales_purchases']" position="after">
                <page name="screwdriver_rental" string="Screwdriver Rentals">
                    <separator string="Current Rentals" />
                    <field name="screwdriver_rental_active_ids"
                        context="{'default_partner_id': active_id}">
                        <tree editable="bottom" no_open="1">
                            <field name="screwdriver_id" />
                            <field name="rental_date" />
                            <field name="return_date" />
                        </tree>
                    </field>
                    <separator string="Rental History" />
                    <field name="screwdriver_rental_history_ids"
                        context="{'default_partner_id': active_id}">
                        <tree no_open="1" create="0" delete="0">
                            <field name="screwdriver_id" />
                            <field name="rental_date" />
                            <field name="return_date" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>