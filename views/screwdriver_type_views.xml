<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="screwdriver_type_form_view" model="ir.ui.view">
        <field name="name">screwdriver.type.form</field>
        <field name="model">screwdriver.type</field>
        <field name="arch" type="xml">
            <form string="Screwdriver Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="name_old_sys" />
                        </group>
                        <group>
                            <field name="description" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="screwdriver_type_tree_view" model="ir.ui.view">
        <field name="name">screwdriver.type.tree</field>
        <field name="model">screwdriver.type</field>
        <field name="arch" type="xml">
            <tree string="Screwdriver Types">
                <field name="name" />
                <field name="name_old_sys" />
                <field name="description" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="screwdriver_type_action" model="ir.actions.act_window">
        <field name="name">Screwdriver Types</field>
        <field name="res_model">screwdriver.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="screwdriver_type_menu"
        name="Screwdriver Types"
        parent="screwdriver_rental_management_menu"
        action="screwdriver_type_action"
        sequence="30" />
</odoo>